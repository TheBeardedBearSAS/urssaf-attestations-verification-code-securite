    "/codes_securite/verifier" : {
      "get" : {
        "summary" : "Verifier une attestation via son code de securite",
        "operationId" : "verifierCodeSecuriteAttestationGen",
        "produces" : [ "application/json" ],
        "parameters" : [ {
          "name" : "codeSecurite",
          "in" : "query",
          "description" : "Le code de securite",
          "required" : true,
          "type" : "string"
        } ],
        "responses" : {
          "200" : {
            "description" : "Verification effectuee",
            "schema" : {
              "$ref" : "#/definitions/VerifierCodeSecuriteAttestationGenResultatDto"
            }
          },
          "400" : {
            "description" : "Requete incorrecte ou erreur fonctionnelle lors de la recherche"
          },
          "401" : {
            "description" : "Token d'authentification absent ou invalide"
          }
        }
      },
      "post" : {
        "summary" : "Verifier plusieurs attestations via leurs codes de securite (Max 100 codes de securite)",
        "operationId" : "verifierListeCodesSecuriteAttestationGen",
        "produces" : [ "application/json" ],
        "parameters" : [ {
          "in" : "body",
          "name" : "requete",
          "description" : "La requete",
          "required" : true,
          "schema" : {
            "$ref" : "#/definitions/VerifierCodesSecuriteAttestationGenRequeteDto"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "Verification effectuee",
            "schema" : {
              "$ref" : "#/definitions/VerifierCodeSecuriteAttestationGenResultatDto"
            }
          },
          "400" : {
            "description" : "Requete incorrecte ou erreur fonctionnelle lors de la recherche"
          },
          "401" : {
            "description" : "Token d'authentification absent ou invalide"
          }
        }
      }
    }
  },
  "securityDefinitions" : {
    "securityHeader" : {
      "description" : "Jeton d'authentification obligatoire (Oauth2 Client Credentials)",
      "type" : "oauth2",
      "tokenUrl" : "https://api.urssaf.fr/api/oauth/v1/token",
      "flow" : "application",
      "scopes" : {
        "attn.codes_securite" : "Acces a l'API Attestations Verification Code Securite"
