{
  "swagger" : "2.0",
  "info" : {
    "description" : "L'API Attestation de verification de code de securite permet de verifier la validite d'une attestation produite par l’Urssaf a partir du code de securite.",
    "version" : "1.0.1",
    "title" : "API Attestations Verification Code Securite"
  },
  "basePath" : "/attn/verification/v1",
